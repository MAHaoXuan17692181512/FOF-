def equal_weight_solver(funds):
    if len(funds) == 0:
        return pd.Series(dtype=float)
    w = np.ones(len(funds)) / len(funds)
    return pd.Series(w, index=funds)

def min_variance_solver(cov):
    funds = cov.index.tolist()
    n = len(funds)
    cov_mat = cov.values
    np.random.seed(42)  # 为了可重复性
    x0 = np.random.random(n)
    x0 = x0 / x0.sum()
    cons = ({'type': 'eq', 'fun': lambda w: w.sum() - 1})
    bounds = [(0, 1)] * n

    def obj(w):
        return float(w @ cov_mat @ w)

    # 尝试SLSQP
    res = minimize(obj, x0, method="SLSQP", bounds=bounds, constraints=cons)

    # 如果失败，尝试COBYLA（对约束处理较好）
    if not res.success:
        res = minimize(obj, x0, method="trust-constr", bounds=bounds, constraints=cons)

    return pd.Series(res.x if res.success else np.ones(n) / n, index=funds)

def max_sharpe_solver(ret_hist, cov):
    """
    ret_hist: daily returns DataFrame for the allowed funds (index dates, columns funds)
    cov: covariance matrix (daily)
    We compute expected returns as mean daily * 252 (annualized)
    Covariance is annualized by *252
    """
    funds = cov.index.tolist()
    n = len(funds)
    if n == 0:
        return pd.Series(dtype=float)
    mu_daily = ret_hist[funds].mean()
    mu = (mu_daily * 252).values  # annualized expected returns
    cov_ann = cov.values * 252
    np.random.seed(42)  # 为了可重复性
    x0 = np.random.random(n)
    x0 = x0 / x0.sum()
    bounds = [(0, 1)] * n
    cons = ({'type': 'eq', 'fun': lambda w: w.sum() - 1})

    # maximize Sharpe -> minimize negative Sharpe
    def obj(w):
        port_ret = w @ mu
        port_vol = np.sqrt(w @ cov_ann @ w)
        if port_vol <= 0:
            return 1e6
        sharpe = (port_ret - rf) / port_vol
        return -sharpe

    res = minimize(obj, x0, method="SLSQP", bounds=bounds, constraints=cons)
    if not res.success:
        res = minimize(obj, x0, method="trust-constr", bounds=bounds, constraints=cons)

    return pd.Series(res.x if res.success else np.ones(n) / n, index=funds)

def max_diversification_solver(ret_hist, cov):
    """
    Maximize Diversification Ratio: DR(w) = (w' sigma) / sqrt(w' Σ w)
    where sigma is vector of individual volatilities (annualized)
    We minimize -DR(w)
    """
    funds = cov.index.tolist()
    n = len(funds)
    if n == 0:
        return pd.Series(dtype=float)
    sigma = np.sqrt(np.diag(cov.values) * 252)  # annualized individual vol
    cov_ann = cov.values * 252
    np.random.seed(42)  # 为了可重复性
    x0 = np.random.random(n)
    x0 = x0 / x0.sum()
    bounds = [(0, 1)] * n
    cons = ({'type': 'eq', 'fun': lambda w: w.sum() - 1})

    def dr_obj(w):
        w = np.array(w)
        numerator = w @ sigma
        denom = np.sqrt(w @ cov_ann @ w)
        if denom <= 0:
            return 1e6
        dr = numerator / denom
        return -dr  # minimize negative -> maximize dr

    res = minimize(dr_obj, x0, method="SLSQP", bounds=bounds, constraints=cons)
    if not res.success:
        res = minimize(dr_obj, x0, method="COBYLA", bounds=bounds, constraints=cons)
    return pd.Series(res.x, index=funds)

cov_cache = {}

def _find_nearest_index_on_or_before(ts_index, dt):
    """找到 ts_index 中 <= dt 的最后一个索引位置（整数索引），若没有返回 None。"""
    if dt in ts_index:
        return ts_index.get_loc(dt)
    # 取小于等于 dt 的最后一个
    le = ts_index[ts_index <= dt]
    if len(le) == 0:
        return None
    return ts_index.get_loc(le[-1])

def get_cov_for_quarter(q, allowed):
    """
    返回该季度使用的协方差矩阵（只计算一次并缓存）。
    q: 'YYYYQn' 字符串
    allowed: 当次调仓允许的基金列表（用于从历史数据中挑选列）
    特殊：若 q == '2022Q1' 则使用 cov_date = 2022-01-25；否则使用季度第一天（rebalance_date 即为该季度第一天）
    """
    # 缓存 key 以季度 + allowed 列表排序为准，避免不同基金集合重复计算
    key = (q, tuple(sorted(allowed)))
    if key in cov_cache:
        return cov_cache[key]

    # 选择计算协方差的基准日期 cov_date
    if q == "2022Q1":
        cov_date = pd.Timestamp("2022-01-25")
    else:
        # 找到 quarter_dates 中对应 q 的那天（quarter_dates 在外部已定义）
        # 如果找不到（理论上不会），退回到第一个 >= 该季度的 valid_dates
        matching = [d for d in quarter_dates if get_quarter(d) == q]
        cov_date = matching[0] if len(matching) > 0 else None
        if cov_date is None:
            # 退化：取该季度第一个 valid_dates
            cov_date = valid_dates[valid_dates.map(lambda d: get_quarter(d) == q)][0]

    # 确保 cov_date 在 daily_ret.index 或取其之前最近的一个可用交易日
    cov_idx = _find_nearest_index_on_or_before(daily_ret.index, cov_date)
    if cov_idx is None:
        # 没有可用历史数据
        cov_cache[key] = pd.DataFrame()
        return cov_cache[key]
    cov_dt = daily_ret.index[cov_idx]

    # 计算历史窗口起点索引（与原逻辑使用相同的 lookback）
    start_idx = max(0, cov_idx - lookback)
    hist = daily_ret.iloc[start_idx:cov_idx + 1][allowed].dropna(how="all")
    hist = hist.loc[:, ~hist.columns.duplicated()]

    if hist.shape[0] < 5:
        cov_mat = pd.DataFrame()  # insufficient data
    else:
        cov_mat = hist.cov()
        cov_mat = cov_mat.loc[~cov_mat.index.duplicated(), ~cov_mat.columns.duplicated()]
        valid_cols = cov_mat.columns[cov_mat.notna().all()]
        cov_mat = cov_mat.loc[valid_cols, valid_cols]

    cov_cache[key] = cov_mat
    return cov_mat

