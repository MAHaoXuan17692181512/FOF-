            plt.close()
            print(f"已保存末期柱状图: {fname_bar}")

            # 保存到待写入的字典（每个策略一个 sheet）
            excel_plot_tables[f"策略_{name}_权重分布"] = df_strategy

        except Exception as e:
            print(f"绘制/处理策略 {name} 出错，跳过该策略：{e}")
            continue

    # 将所有策略的权重时间序列写入 output_file（每个策略一个 sheet）
    try:
        if os.path.exists(output_file):
            # 用 append 模式并替换同名 sheet
            with pd.ExcelWriter(output_file, engine='openpyxl', mode='a', if_sheet_exists='replace') as writer:
                for sheet_name, df in excel_plot_tables.items():
                    if df is None or df.shape[0] == 0:
                        # 仍写入空表以示存在（可根据需要改成跳过）
                        df.to_excel(writer, sheet_name=sheet_name)
                    else:
                        df.to_excel(writer, sheet_name=sheet_name)
        else:
            with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
                for sheet_name, df in excel_plot_tables.items():
                    if df is None or df.shape[0] == 0:
                        df.to_excel(writer, sheet_name=sheet_name)
                    else:
                        df.to_excel(writer, sheet_name=sheet_name)
        print(f"每个策略的各资产类别权重已写入 Excel（每策略一个 sheet）：{output_file}")
    except Exception as e:
        print("写入每策略权重数据到 Excel 失败：", e)


# ---------- 辅助小函数：把策略名转换为文件系统安全的文件名 ----------
def safe_filename(s):
    try:
        # 简单替换空格和特殊字符
        return "".join(c if c.isalnum() or c in ("_", "-") else "_" for c in str(s))
    except Exception:
        return "strategy"
