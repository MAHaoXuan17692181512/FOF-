def calculate_benchmark_nav(daily_ret, fund_quarter, fund_type, start_date="2022-01-01", start_nav=100.0):
    """
    计算股2债8基准净值
    每季度使用该季度可用的股票型和债券型基金计算平均收益
    """

    # 筛选指定日期之后的收益率数据
    valid_dates = daily_ret.index[daily_ret.index >= pd.Timestamp(start_date)]
    daily_ret_filtered = daily_ret.loc[valid_dates]

    # 获取季度调仓日期（与主代码一致）
    def get_quarter(dt):
        m = dt.month
        return f"{dt.year}Q{(m - 1) // 3 + 1}"

    quarter_dates = []
    current_quarter = None
    for today in valid_dates:
        q = get_quarter(today)
        if q != current_quarter:
            quarter_dates.append(today)
            current_quarter = q

    print(f"季度调仓日期: {[d.strftime('%Y-%m-%d') for d in quarter_dates]}")

    # 计算基准净值
    benchmark_nav = pd.Series(0.0, index=valid_dates)
    benchmark_nav.iloc[0] = start_nav

    # 逐日计算基准收益
    for i in range(1, len(valid_dates)):
        today = valid_dates[i]
        current_q = get_quarter(today)

        # 筛选当前季度可用的股票型和债券型基金
        stock_funds_current_q = []
        bond_funds_current_q = []

        for fund in daily_ret_filtered.columns:
            # 检查基金是否在当前季度可用
            if fund_quarter.get(fund) == current_q:
                category = get_fund_category(fund)
                if category == "股票型":
                    stock_funds_current_q.append(fund)
                elif category == "债券型":
                    bond_funds_current_q.append(fund)

        # 计算当日股票和债券平均收益
        if stock_funds_current_q and bond_funds_current_q:
            stock_ret_today = daily_ret_filtered.loc[today, stock_funds_current_q].mean()
            bond_ret_today = daily_ret_filtered.loc[today, bond_funds_current_q].mean()

            # 处理NaN值
            stock_ret_today = 0 if pd.isna(stock_ret_today) else stock_ret_today
            bond_ret_today = 0 if pd.isna(bond_ret_today) else bond_ret_today

            # 计算基准当日收益 (股2债8)
            benchmark_ret_today = stock_ret_today * 0.2 + bond_ret_today * 0.8

        else:
            # 如果没有可用的基金，收益为0
            benchmark_ret_today = 0
            if i == 1:  # 只在第一天打印警告
                print(f"警告: {today.date()} 季度 {current_q} 缺少股票型或债券型基金")

        # 更新净值
        benchmark_nav.iloc[i] = benchmark_nav.iloc[i - 1] * (1 + benchmark_ret_today)

    return benchmark_nav


