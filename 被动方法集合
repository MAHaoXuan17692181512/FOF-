# ===================== 风险预算优化 =====================
def risk_budget_weights(cov):
    funds = cov.index.tolist()
    n = len(funds)
    cov_mat = cov.values
    categories = [get_fund_category(f) for f in funds]

    risk_budget_vector = np.zeros(n)
    from collections import Counter
    count_by_cat = Counter(categories)
    for i, cat in enumerate(categories):
        cat_budget = CATEGORY_RISK_BUDGET.get(cat, 0.0)
        risk_budget_vector[i] = cat_budget / count_by_cat[cat] if count_by_cat[cat] > 0 else 0.0
    risk_budget_vector /= risk_budget_vector.sum()
    x0 = np.ones(n) / n
    cons = [{'type': 'eq', 'fun': lambda w: w.sum() - 1}]
    bounds = [(0, 1)] * n

    def objective(w):
        port_vol = np.sqrt(w @ cov_mat @ w)
        if port_vol < 1e-12:
            return 1e12
        marginal_contrib = cov_mat @ w
        risk_contrib = w * marginal_contrib
        rc_fraction = risk_contrib / (port_vol ** 2)
        return ((rc_fraction - risk_budget_vector)**2).sum()

    res = minimize(objective, x0, constraints=cons, bounds=bounds, method="SLSQP")
    if not res.success:
        return pd.Series(np.ones(n)/n, index=funds)
    return pd.Series(res.x, index=funds)


