def find_meta_row_by_firstcol(keywords):
    for i in range(20):
        v = raw.iat[i, 0]
        if pd.isna(v):
            continue
        s = str(v).strip().lower()
        for kw in keywords:
            if kw.lower() in s:
                return i
    return None


row_fundcode = find_meta_row_by_firstcol(["基金代码"])
row_cluster = find_meta_row_by_firstcol(["聚类"])
row_quarter = find_meta_row_by_firstcol(["季度"])
row_fundname = find_meta_row_by_firstcol(["基金名称"])
row_fundtype = find_meta_row_by_firstcol(["基金类型"])

print("Found rows:", row_fundcode, row_cluster, row_quarter, row_fundname)
if row_fundcode is None:
    raise ValueError("找不到基金代码行")

# ============================================================
# 识别日期开始行
# ============================================================
date_start = None
for i in range(row_fundcode + 1, nrows):
    dt = pd.to_datetime(raw.iat[i, 0], errors='coerce')
    if not pd.isna(dt):
        date_start = i
        break
if date_start is None:
    raise ValueError("找不到日期开始行")
print("date_start:", date_start)

# ============================================================
# 找基金列
# ============================================================
fund_cols = []
fund_codes = {}
for c in range(1, ncols):
    v = raw.iat[row_fundcode, c]
    if pd.isna(v):
        continue
    code = str(v).strip()
    fund_cols.append(c)
    fund_codes[c] = code

# 去重基金代码（确保无重复）
unique_cols = []
seen = set()
for c in fund_cols:
    cd = fund_codes[c]
    if cd not in seen:
        seen.add(cd)
        unique_cols.append(c)

fund_cols = unique_cols
print("基金数量:", len(fund_cols))

# ============================================================
# NAV 数据
# ============================================================
dates = pd.to_datetime(raw.iloc[date_start:, 0], errors='coerce')
valid_mask = ~dates.isna()
dates = dates[valid_mask].reset_index(drop=True)

nav_part = raw.iloc[date_start:, fund_cols].loc[valid_mask].reset_index(drop=True)
nav_part = nav_part.apply(pd.to_numeric, errors="coerce")
nav_part.index = dates
nav_part.columns = [fund_codes[c] for c in fund_cols]

daily_ret = nav_part.pct_change().dropna(how="all")


# ============================================================
# 元信息
def get_meta(row, c):
    if row is None:
        return None
    v = raw.iat[row, c]
    return None if pd.isna(v) else str(v).strip()


