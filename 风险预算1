def is_bond_fund(fund_code):
    """根据基金类型判断是否为债券型基金（排除股票、商品、QDII等类型）"""
    fund_type_str = fund_type.get(fund_code, "")
    if not fund_type_str:
        return False

    # 定义需要排除的非债券类型关键词
    exclude_keywords = ["股", "商品", "QDII"]

    # 检查是否包含任何排除关键词
    for keyword in exclude_keywords:
        if keyword in fund_type_str:
            return False

    # 如果不包含任何排除关键词，即认为是债券型基金
    return True

def get_fund_category(fund_code):
    """获取基金类别（用于风险预算分配）"""
    fund_type_str = fund_type.get(fund_code, "")
    if not fund_type_str:
        return "其他"

    if "股票" in fund_type_str or "股" in fund_type_str:
        return "股票型"
    elif "债" in fund_type_str:
        return "债券型"
    elif "混合" in fund_type_str:
        return "混合型"
    elif "商品" in fund_type_str or "黄金" in fund_type_str:
        return "商品型"
    elif "QDII" in fund_type_str or "纳斯达克" in fund_type_str:
        return "QDII"
    else:
        return "其他"


fund_quarter = {fund_codes[c]: get_meta(row_quarter, c) for c in fund_cols}
fund_cluster = {fund_codes[c]: get_meta(row_cluster, c) for c in fund_cols}
fund_type = {fund_codes[c]: get_meta(row_fundtype, c) for c in fund_cols}


# ============================================================
# 风险预算优化
# ============================================================
def risk_budget_weights(cov, allowed_funds=None, always_allowed=None):
    cov_mat = cov.values
    n = len(cov)

    # 计算每个资产的风险预算
    risk_budgets = np.ones(n)  # 默认等风险预算

    if allowed_funds is not None:
        # 根据基金类别分配风险预算
        for i, fund in enumerate(cov.index):
            category = get_fund_category(fund)
            risk_budgets[i] = RISK_BUDGET.get(category, 0.05)  # 默认5%

    # 归一化风险预算
    risk_budgets = risk_budgets / risk_budgets.sum()

    always_indices = []
    if always_allowed and allowed_funds is not None:
        for fund in always_allowed:
            if fund in cov.index:
                idx = list(cov.index).index(fund)
                always_indices.append(idx)

    # 使用随机初值
    np.random.seed(42)
    x0 = np.random.dirichlet(np.ones(n))

    cons = [{'type': 'eq', 'fun': lambda w: w.sum() - 1}]

    # ALWAYS_ALLOWED 权重约束
    if always_indices:
        def always_constraint(w):
            return 0.15 - w[always_indices].sum()  # 权重和 <= 15%

        cons.append({'type': 'ineq', 'fun': always_constraint})

    bnds = tuple((0, 1) for _ in range(n))

    def obj(w):
        port_vol = np.sqrt(w @ cov_mat @ w)
        if port_vol < 1e-12:
            return 1e12  # 惩罚零波动情况

        # 计算每个资产的风险贡献
        risk_contributions = (w * (cov_mat @ w)) / port_vol

        # 计算风险贡献与目标风险预算的差异
        relative_diff = risk_contributions / port_vol - risk_budgets
        return (relative_diff ** 2).sum()

    res = minimize(obj, x0, method="SLSQP", bounds=bnds, constraints=cons)
    if not res.success:
        # 如果优化失败，使用基于风险预算的启发式初始解
        vol = np.sqrt(np.diag(cov_mat))
        heuristic_weights = risk_budgets / vol
        heuristic_weights = heuristic_weights / heuristic_weights.sum()
        return pd.Series(heuristic_weights, index=cov.index)

    return pd.Series(res.x, index=cov.index)


# ============================================================
# 回测
# ============================================================
def get_quarter(dt):
    m = dt.month
    return f"{dt.year}Q{(m - 1) // 3 + 1}"


all_dates = daily_ret.index
all_funds = daily_ret.columns.tolist()
start_date = pd.Timestamp("2022-01-01")
valid_dates = all_dates[all_dates >= start_date]
if len(valid_dates) == 0:
    raise ValueError("没有找到2022-01-01之后的数据")

# 按分类存储结果
clusters = ["0", "1", "2", "3", "4", "5"]
results = {}

for cluster in clusters:
    results[cluster] = {
        'nav': pd.Series(1.0, index=valid_dates),
        'weights': pd.DataFrame(0.0, index=valid_dates, columns=all_funds)
    }

lookback = 20

print("使用风险预算配置 (季度调仓，每日净值计算):")
for category, budget in RISK_BUDGET.items():
    print(f"  {category}: {budget:.1%}")

# 按季度调仓
quarter_dates = []
current_quarter = None
for today in valid_dates:
    q = get_quarter(today)
    if q != current_quarter:
        quarter_dates.append(today)
        current_quarter = q

print(f"总交易日: {len(valid_dates)}, 调仓日期: {len(quarter_dates)}")

# 优化缓存
optimization_cache = {}

for i, rebalance_date in enumerate(quarter_dates):
    print(f"调仓 {i + 1}/{len(quarter_dates)}: {rebalance_date}")

    for cluster in clusters:
        today = rebalance_date
        q = get_quarter(today)

        allowed = [
            f for f in all_funds
            if fund_quarter.get(f) == q and (
                    is_bond_fund(f) or
                    str(fund_cluster.get(f)) == cluster
            )
        ]

        allowed = sorted(list(set(allowed) | (set(ALWAYS_ALLOWED) & set(all_funds))))

        if len(allowed) == 0:
            continue
        elif len(allowed) == 1:
            w = pd.Series(1.0, index=allowed)
        else:
            idx_in_all = all_dates.get_loc(today)
            start = max(0, idx_in_all - lookback)
            hist = daily_ret.iloc[start:idx_in_all][allowed].dropna(how="all")
            hist = hist.loc[:, ~hist.columns.duplicated()]

            if hist.shape[0] < 5:
                w = pd.Series(1 / len(allowed), index=allowed)
            else:
                cov = hist.cov()
                cov = cov.loc[~cov.index.duplicated(), ~cov.columns.duplicated()]
                valid_cols = cov.columns[cov.notna().all()]
                cov = cov.loc[valid_cols, valid_cols]

                if len(cov) == 0:
                    w = pd.Series(1 / len(allowed), index=allowed)
                else:
                    cache_key = f"{q}_{cluster}_{tuple(sorted(allowed))}"
                    if cache_key in optimization_cache:
                        w_part = optimization_cache[cache_key]
                    else:
                        w_part = risk_budget_weights(cov, allowed_funds=allowed, always_allowed=ALWAYS_ALLOWED)
                        optimization_cache[cache_key] = w_part

                    w = pd.Series(0.0, index=allowed)
                    for f in w_part.index:
                        if f in w.index:
                            w[f] = w_part[f]

                    if w.sum() <= 0:
                        w[:] = 1 / len(allowed)
                    else:
                        w /= w.sum()

        # 应用权重到整个季度
        next_rebalance = quarter_dates[i + 1] if i + 1 < len(quarter_dates) else valid_dates[-1]
        mask_dates = valid_dates[(valid_dates >= today) & (valid_dates < next_rebalance)]

        for date_idx in mask_dates:
            # 重置权重
            results[cluster]['weights'].loc[date_idx, :] = 0.0
            # 分配新权重
            for fund in w.index:
                if fund in results[cluster]['weights'].columns:
                    results[cluster]['weights'].loc[date_idx, fund] = w[fund]

# 每日净值计算
print("开始每日净值计算...")
for cluster in clusters:
    results[cluster]['nav'].iloc[0] = 1.0

    for i in range(1, len(valid_dates)):
        today = valid_dates[i]
        prev_date = valid_dates[i - 1]

        today_weights = results[cluster]['weights'].loc[today]
        today_returns = daily_ret.loc[today]

        portfolio_return = 0.0
        for fund in today_weights.index:
            if today_weights[fund] > 0 and fund in today_returns.index and not pd.isna(today_returns[fund]):
                portfolio_return += today_weights[fund] * today_returns[fund]

        prev_nav = results[cluster]['nav'].loc[prev_date]
        results[cluster]['nav'].loc[today] = prev_nav * (1 + portfolio_return)

        if i % 50 == 0:
            print(f"Cluster {cluster}: {today} NAV = {results[cluster]['nav'].loc[today]:.4f}")

print("净值计算完成！")

