    with pd.ExcelWriter(output_file, engine='openpyxl') as writer:
        # 输出每个分类的净值
        for cluster in clusters:
            # 净值输出
            nav_df = results[cluster]['nav'].to_frame(f"NAV_Cluster{cluster}")
            nav_df.to_excel(writer, sheet_name=f"净值_类{cluster}")

            # 权重输出 - 只输出有权重的日期和基金
            weights_df = results[cluster]['weights']
            # 过滤掉全为0的行和列
            non_zero_rows = (weights_df != 0).any(axis=1)
            non_zero_cols = (weights_df != 0).any(axis=0)
            filtered_weights = weights_df.loc[non_zero_rows, non_zero_cols]

            if not filtered_weights.empty:
                filtered_weights.to_excel(writer, sheet_name=f"权重_类{cluster}")
            else:
                # 如果全为0，输出空表
                weights_df.iloc[:0].to_excel(writer, sheet_name=f"权重_类{cluster}")

        # 输出风险预算配置
        risk_budget_df = pd.DataFrame.from_dict(RISK_BUDGET, orient='index', columns=['风险预算'])
        risk_budget_df.to_excel(writer, sheet_name="风险预算配置")

    print(f"成功输出到: {output_file}")

except Exception as e:
    print(f"输出到Excel时出错: {e}")
    # 备用方案：输出到CSV
    print("尝试输出到CSV文件...")
    for cluster in clusters:
        results[cluster]['nav'].to_csv(f"nav_cluster{cluster}.csv")
        results[cluster]['weights'].to_csv(f"weights_cluster{cluster}.csv")
    print("已输出到CSV文件")

print("程序执行完成！")
