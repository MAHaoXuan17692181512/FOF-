real_weights = {c: pd.DataFrame(index=valid_dates, columns=all_funds, dtype=float) for c in clusters}

for cluster in clusters:
    results[cluster] = {
        'nav': pd.Series(100.0, index=valid_dates),
        'weights': pd.DataFrame(0.0, index=valid_dates, columns=all_funds)
    }

lookback = 20
FEE_RATE = 0.001

# ===================== 调仓日期 =====================
quarter_dates = []
current_quarter = None
for today in valid_dates:
    q = get_quarter(today)
    if q != current_quarter:
        quarter_dates.append(today)
        current_quarter = q

optimization_cache = {}

for i, rebalance_date in enumerate(quarter_dates):
    for cluster in clusters:
        today = rebalance_date
        q = get_quarter(today)
        allowed = []
        for f in all_funds:
            if fund_quarter.get(f) != q:
                continue
            cat = get_fund_category(f)
            if cat == "股票型" or is_bond_fund(f):
                allowed.append(f)
            else:
                allowed.append(f)
        allowed = sorted(list(set(allowed) | (set(ALWAYS_ALLOWED) & set(all_funds))))
        if len(allowed) == 0:
            continue
        elif len(allowed) == 1:
            w = pd.Series(1.0, index=allowed)
        else:
            idx_in_all = all_dates.get_loc(today)
            start = max(0, idx_in_all - lookback)
            hist = daily_ret.iloc[start:idx_in_all][allowed].dropna(how="all")
            hist = hist.loc[:, ~hist.columns.duplicated()]
            if hist.shape[0] < 5:
                w = pd.Series(1 / len(allowed), index=allowed)
            else:
                cov = hist.cov()
                cov = cov.loc[~cov.index.duplicated(), ~cov.columns.duplicated()]
                valid_cols = cov.columns[cov.notna().all()]
                cov = cov.loc[valid_cols, valid_cols]
                if len(cov) == 0:
                    w = pd.Series(1 / len(allowed), index=allowed)
                else:
                    cache_key = f"{q}_{cluster}_{tuple(sorted(allowed))}"
                    if cache_key in optimization_cache:
                        w_part = optimization_cache[cache_key]
                    else:
                        w_part = risk_budget_weights(cov)
                        optimization_cache[cache_key] = w_part
                    w = pd.Series(0.0, index=allowed)
                    for f in w_part.index:
                        if f in w.index:
                            w[f] = w_part[f]
                    w /= w.sum()


        # ====== 调仓日处理 ======
        prev_candidates = valid_dates[valid_dates < today]
        if len(prev_candidates) == 0:
            # 第一次调仓日
            cluster_nav = 100.0  # 初始 NAV
            prev_holding = pd.Series(0.0, index=all_funds)
        else:
            prev_day = prev_candidates[-1]
            cluster_nav = results[cluster]['nav'].loc[prev_day]  # 前一天 NAV
            prev_holding = holdings[cluster].loc[prev_day].fillna(0)

        # 计算目标持仓金额
        target_value = w.reindex(all_funds, fill_value=0) * cluster_nav
        fee = (target_value - prev_holding).abs().sum() * FEE_RATE
        cluster_nav -= fee  # 扣手续费

        # 更新 NAV 和 holdings
        results[cluster]['nav'].loc[today] = cluster_nav
        holdings[cluster].loc[today] = target_value

        # 当日持仓份额随收益率滚动
        ret_today = daily_ret.loc[today].reindex(all_funds, fill_value=0)
        holdings[cluster].loc[today] = holdings[cluster].loc[today] * (1 + ret_today)
        real_weights[cluster].loc[today] = holdings[cluster].loc[today] / holdings[cluster].loc[today].sum()

        # ====== 应用到整个季度 ======
        next_rebalance = quarter_dates[i + 1] if i + 1 < len(quarter_dates) else valid_dates[-1]
        mask_dates = valid_dates[(valid_dates > today) & (valid_dates < next_rebalance)]

        prev_holding = holdings[cluster].loc[today]  # 调仓日持仓作为起点

        for date_idx in mask_dates:
            # 当天收益
            daily_ret_today = daily_ret.loc[date_idx].reindex(all_funds, fill_value=0)

            # 当天持仓 = 昨日持仓 * (1 + 收益)
            holdings_today = prev_holding * (1 + daily_ret_today)
            holdings[cluster].loc[date_idx] = holdings_today

            # 当天组合价值
            total_value = holdings_today.sum()
            results[cluster]['nav'].loc[date_idx] = total_value

            # 当天真实权重 = 当天持仓金额 / 总价值
            real_weights[cluster].loc[date_idx] = holdings_today / total_value

            # 权重表（仅记录目标权重，不是实际权重）
            results[cluster]['weights'].loc[date_idx] = w.reindex(all_funds, fill_value=0)

            # 更新 prev_holding，为下一天使用
            prev_holding = holdings_today
