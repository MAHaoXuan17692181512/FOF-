# === 新增：按分类存储结果 ===
clusters = ["0", "1","2","3","4","5"]  # 根据你的聚类值定义
results = {}

for cluster in clusters:
    results[cluster] = {
        'nav': pd.Series(1.0, index=valid_dates),
        'weights': pd.DataFrame(0.0, index=valid_dates, columns=all_funds)
    }


lookback = 20
for i, today in enumerate(valid_dates):
    q = get_quarter(today)

    # 分别处理每个分类
    # for cluster in clusters:
    #     allowed = [
    #         f for f in all_funds
    #         if fund_quarter.get(f) == q and str(fund_cluster.get(f)) == cluster
    #     ]
    for cluster in clusters:
        allowed = [
            f for f in all_funds
            if fund_quarter.get(f) == q and (
                # 债券型基金：只筛选时间，不筛选聚类
                    is_bond_fund(f) or
                    # 非债券型基金：既筛选时间也筛选聚类
                    str(fund_cluster.get(f)) == cluster
            )
        ]

        # 强制添加 ALWAYS_ALLOWED（只在当前分类中）
        allowed = sorted(list(set(allowed) | (set(ALWAYS_ALLOWED) & set(all_funds))))

        if len(allowed) == 0:
            continue
        elif len(allowed) == 1:
            results[cluster]['weights'].loc[today, allowed[0]] = 1.0
        else:
            # 取历史
            idx_in_all = all_dates.get_loc(today)
            start = max(0, idx_in_all - lookback)
            hist = daily_ret.iloc[start:idx_in_all][allowed].dropna(how="all")

            # 去重列名, 防止 duplicate
            hist = hist.loc[:, ~hist.columns.duplicated()]

            if hist.shape[0] < 5:
                w = pd.Series(1 / len(allowed), index=allowed)
            else:
                cov = hist.cov()

                # 去掉协方差矩阵中的重复列
                cov = cov.loc[~cov.index.duplicated(), ~cov.columns.duplicated()]

                # 删除不可用列
                valid_cols = cov.columns[cov.notna().all()]
                cov = cov.loc[valid_cols, valid_cols]

                if len(cov) == 0:
                    w = pd.Series(1 / len(allowed), index=allowed)
                else:
                    # bond_funds_in_cov = [f for f in cov.columns if is_bond_fund(f)]
                    # if bond_funds_in_cov:
                    #     print(f"日期 {today}, 聚类 {cluster}: 债券基金在协方差矩阵中: {bond_funds_in_cov}")
                    #     for bond_fund in bond_funds_in_cov:
                    #         bond_vol = cov.loc[bond_fund, bond_fund]  # 债券基金方差
                    #         bond_std = np.sqrt(bond_vol)  # 债券基金标准差
                    #         print(f"  {bond_fund}: 方差={bond_vol:.6f}, 标准差={bond_std:.4f}")

                    w_part = risk_parity_weights(cov, allowed_funds=allowed, always_allowed=ALWAYS_ALLOWED)

                    # 安全对齐，不再用 reindex
                    w = pd.Series(0.0, index=allowed)
                    for f in w_part.index:
                        if f in w.index:
                            w[f] = w_part[f]

                    if w.sum() <= 0:
                        w[:] = 1 / len(allowed)
                    else:
                        w /= w.sum()

            results[cluster]['weights'].loc[today] = w

        # NAV 更新（每个分类独立更新）
        if i > 0:
            r = (results[cluster]['weights'].loc[today] * daily_ret.loc[today]).sum()
            results[cluster]['nav'].iloc[i] = results[cluster]['nav'].iloc[i - 1] * (1 + r)

    # ============================================================
    # 输出
    # ============================================================
