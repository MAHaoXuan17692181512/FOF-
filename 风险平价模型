def get_meta(row, c):
    if row is None:
        return None
    v = raw.iat[row, c]
    return None if pd.isna(v) else str(v).strip()

def is_bond_fund(fund_code):
    """根据基金类型判断是否为债券型基金"""
    fund_type_str = fund_type.get(fund_code, "")
    if fund_type_str and "债" in fund_type_str:  # 如果类型包含"债"字
        return True
    return False

