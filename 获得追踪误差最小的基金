def get_fund_data_tushare(fund_code, start_date, end_date):
    """
    使用Tushare获取基金数据
    """
    if ts_pro is None:
        return None

    try:
        # 判断是场内还是场外
        if fund_code in MARKET_CODE_MAPPING:
            # 场内基金 - 使用fund_daily接口
            ts_code = MARKET_CODE_MAPPING[fund_code]
            df = ts_pro.fund_daily(
                ts_code=ts_code,
                start_date=start_date,
                end_date=end_date
            )
        else:
            # 场外基金 - 使用fund_nav接口
            # Tushare的场外基金代码不需要后缀
            df = ts_pro.fund_nav(
                ts_code=fund_code,
                start_date=start_date,
                end_date=end_date
            )

        if df is not None and len(df) > 0:
            # 统一列名
            if 'trade_date' in df.columns:
                df = df[['trade_date', 'close']].copy()
                df.columns = ['date', 'close']
            elif 'end_date' in df.columns and 'unit_nav' in df.columns:
                df = df[['end_date', 'unit_nav']].copy()
                df.columns = ['date', 'close']
            elif 'nav_date' in df.columns and 'unit_nav' in df.columns:
                df = df[['nav_date', 'unit_nav']].copy()
                df.columns = ['date', 'close']
            else:
                return None

            df['date'] = pd.to_datetime(df['date'])
            df['close'] = pd.to_numeric(df['close'], errors='coerce')
            df = df.dropna()
            df = df.sort_values('date').reset_index(drop=True)

            return df if len(df) >= 100 else None

    except Exception as e:
        # 静默失败，让其他数据源尝试
        pass

    return None


