                df = ak.futures_main_sina(symbol="AU0", start_date=start_date, end_date=end_date)
                if df is not None and len(df) > 0:
                    return df[['date', 'close']].copy()
            except:
                pass

            try:
                # 上海黄金交易所现货价格
                df = ak.spot_hist_sge(symbol="Au99.99")
                if df is not None and len(df) > 0:
                    df = df[['date', 'close']].copy()
                    df['date'] = pd.to_datetime(df['date'])
                    return df
            except:
                pass

        elif index_type == '纳斯达克':
            # 纳斯达克综合指数
            df = ak.index_us_stock_sina(symbol=".IXIC")
            if df is not None and len(df) > 0:
                df = df[['date', 'close']].copy()
                df['date'] = pd.to_datetime(df['date'])
                start = pd.to_datetime(start_date)
                end = pd.to_datetime(end_date)
                df = df[(df['date'] >= start) & (df['date'] <= end)]
                return df

        elif index_type == '货币':
            # 使用上证国债指数作为货币市场指数
            df = ak.stock_zh_index_daily(symbol="sh000012")
            if df is not None and len(df) > 0:
                df = df[['date', 'close']].copy()
                df['date'] = pd.to_datetime(df['date'])
                start = pd.to_datetime(start_date)
                end = pd.to_datetime(end_date)
                df = df[(df['date'] >= start) & (df['date'] <= end)]
                return df

    except Exception as e:
        print(f"  获取{index_type}指数失败: {str(e)[:50]}")

    return None


def calculate_tracking_error(fund_data, index_data):
    """
    计算跟踪误差
    """
    # 合并数据
    merged = pd.merge(fund_data, index_data, on='date', how='inner', suffixes=('_fund', '_index'))

    if len(merged) < 50:
        return None, None, None, None

    # 计算收益率
    merged['R_fund'] = merged['close_fund'].pct_change()
    merged['R_index'] = merged['close_index'].pct_change()

    # 计算跟踪偏离度
    merged['TD'] = merged['R_fund'] - merged['R_index']

    # 去除NaN
    merged = merged.dropna()

    if len(merged) < 50:
        return None, None, None, None

    # 跟踪误差 = 跟踪偏离度的标准差
    TE = merged['TD'].std()
    TE_annual = TE * np.sqrt(252)
    TD_mean = merged['TD'].mean()

    return TE, TE_annual, TD_mean, len(merged)


