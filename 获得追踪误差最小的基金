def safe_get_fund_data(fund_code, start_date, end_date):
    """
    安全获取基金净值数据
    优先级: Tushare > AkShare场外 > AkShare场内
    """
    # 方法0: 尝试Tushare（如果可用）
    if ts_pro is not None:
        data = get_fund_data_tushare(fund_code, start_date, end_date)
        if data is not None:
            print(f"    [Tushare] ", end="")
            return data

    # 方法1: AkShare场外基金净值
    try:
        df = ak.fund_open_fund_info_em(symbol=fund_code, indicator="单位净值走势")
        if df is not None and len(df) > 0:
            df = df[['净值日期', '单位净值']].copy()
            df.columns = ['date', 'close']
            df['date'] = pd.to_datetime(df['date'])
            df['close'] = pd.to_numeric(df['close'], errors='coerce')

            # 筛选日期范围
            start = pd.to_datetime(start_date)
            end = pd.to_datetime(end_date)
            df = df[(df['date'] >= start) & (df['date'] <= end)]
            df = df.dropna()
            df = df.sort_values('date').reset_index(drop=True)

            if len(df) >= 100:
                print(f"    [AkShare场外] ", end="")
                return df
    except:
        pass

    # 方法2: AkShare场内ETF行情
    try:
        df = ak.fund_etf_hist_em(
            symbol=fund_code,
            period="daily",
            start_date=start_date,
            end_date=end_date,
            adjust="qfq"###这里非常好 用的前复权
        )
        if df is not None and len(df) > 0:
            df = df[['日期', '收盘']].copy()
            df.columns = ['date', 'close']
            df['date'] = pd.to_datetime(df['date'])
            df['close'] = pd.to_numeric(df['close'], errors='coerce')
            df = df.dropna()
            df = df.sort_values('date').reset_index(drop=True)

            if len(df) >= 100:
                print(f"    [AkShare场内] ", end="")
                return df
    except Exception as e:
        pass

    return None


def safe_get_index_data(index_type, start_date, end_date):
